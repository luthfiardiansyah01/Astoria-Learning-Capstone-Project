# Salin menjadi .env lalu isi nilainya. Jangan pernah commit .env.

# Basis data PostgreSQL (produksi: Supabase).
# DATABASE_URL = pooler transaksi (port 6543) + ?pgbouncer=true
# DIRECT_URL   = pooler sesi (port 5432), dipakai Prisma untuk migrasi
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# Untuk pengembangan lokal dengan Docker (docker-compose.yml):
# DATABASE_URL="postgresql://astoria:astoria@localhost:5432/astoria?schema=public"
# DIRECT_URL="postgresql://astoria:astoria@localhost:5432/astoria?schema=public"

# NextAuth. Buat rahasia dengan: bun -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# AI (OpenAI-compatible, mis. OpenRouter). Produksi: isi AI_BASE_URL dan AI_API_KEY.
# Lokal boleh memakai file .z-ai-config sebagai gantinya.
AI_BASE_URL="https://openrouter.ai/api/v1"
AI_API_KEY=""
AI_MODEL="cohere/north-mini-code:free"
AI_FALLBACK_MODELS="liquid/lfm-2.5-2.6b:free,google/gemma-4-31b-it:free"
AI_EMBED_MODEL="nvidia/nemotron-3-embed-1b:free"

# Rate limit (produksi). Lokal boleh kosong → fallback memori.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Hanya untuk `bun run seed:prod` (akun admin pertama). Isi sementara, lalu hapus.
SEED_ADMIN_EMAIL="admin@contoh.id"
SEED_ADMIN_PASSWORD="GANTI_DENGAN_PASSWORD_KUAT"
SEED_ADMIN_NAME="Admin SOBAT ADI"
